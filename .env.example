# ─── 카카오 개발자 콘솔 설정 ───────────────────────────────────────────────
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=여기에_REST_API_키_입력

# 앱 설정 → 카카오 로그인 → 보안 → Client Secret (활성화 후 복사)
KAKAO_CLIENT_SECRET=여기에_Client_Secret_입력

# 카카오 로그인 → Redirect URI 에 등록한 주소 (개발: localhost, 배포: 실제 도메인)
# 예) http://localhost:4321/api/kakao-callback
KAKAO_REDIRECT_URI=http://localhost:4321/api/kakao-callback

# ─── Notion Integration 설정 ────────────────────────────────────────────────
# https://www.notion.so/my-integrations → 새 통합 만들기 → 시크릿 토큰
NOTION_TOKEN=secret_여기에_Notion_내부통합_토큰_입력

# 아래 DB ID는 이미 생성된 "타이탄클래스 월말특강 신청자 DB" 입니다 (변경 불필요)
NOTION_DATABASE_ID=a2a81134b49444f8bbcdd102be595317
