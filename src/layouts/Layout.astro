---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "타이탄클래스 | 월 3,000만원의 비밀",
  description = "월 3,000만원 수익을 만드는 대표님의 노하우를 담은 타이탄클래스. 지금 바로 시작하세요.",
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=Noto+Sans+KR:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <a
      href="https://pf.kakao.com/_xoxxxxxx/chat"
      target="_blank"
      rel="noopener noreferrer"
      class="kakao-float"
      aria-label="카카오톡 채널 상담하기"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 3C6.477 3 2 6.582 2 11c0 2.857 1.737 5.379 4.376 6.943L5.5 21l3.432-1.937A11.84 11.84 0 0 0 12 19.2c5.523 0 10-3.582 10-8.2S17.523 3 12 3z"/>
      </svg>
      <span>카카오 상담</span>
    </a>
  </body>
</html>

<style is:global>
  :root {
    --bg-base: #0a0a0a;
    --bg-surface: #141414;
    --bg-elevated: #1c1c1c;
    --gold-primary: #c9a84c;
    --gold-light: #f0d080;
    --gold-dark: #8b6914;
    --gold-muted: rgba(201, 168, 76, 0.12);
    --gold-border: rgba(201, 168, 76, 0.25);
    --text-primary: #ffffff;
    --text-secondary: #b0b0b0;
    --text-muted: #666666;
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 16px;
    --shadow-gold: 0 0 60px rgba(201, 168, 76, 0.1);
    --shadow-card: 0 4px 40px rgba(0, 0, 0, 0.7);
    --transition: 0.25s ease;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html { scroll-behavior: smooth; }

  body {
    background-color: var(--bg-base);
    color: var(--text-primary);
    font-family: "Noto Sans KR", sans-serif;
    font-size: 16px;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4 {
    font-family: "Playfair Display", "Noto Sans KR", serif;
    line-height: 1.2;
  }

  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; height: auto; display: block; }

  .container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .gold-text {
    background: linear-gradient(135deg, var(--gold-primary) 0%, var(--gold-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .btn-gold {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 40px;
    background: linear-gradient(135deg, var(--gold-dark) 0%, var(--gold-primary) 50%, var(--gold-light) 100%);
    color: #0a0a0a;
    font-family: "Noto Sans KR", sans-serif;
    font-weight: 700;
    font-size: 16px;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    transition: all var(--transition);
    box-shadow: 0 4px 24px rgba(201, 168, 76, 0.4);
    letter-spacing: 0.02em;
  }

  .btn-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 40px rgba(201, 168, 76, 0.55);
  }

  .btn-gold:active { transform: translateY(0); }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 36px;
    background: transparent;
    color: var(--gold-primary);
    font-family: "Noto Sans KR", sans-serif;
    font-weight: 500;
    font-size: 15px;
    border-radius: var(--radius-md);
    border: 1px solid var(--gold-border);
    cursor: pointer;
    transition: all var(--transition);
  }

  .btn-outline:hover {
    background: var(--gold-muted);
    border-color: var(--gold-primary);
    color: var(--gold-light);
  }

  .section-label {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 14px;
  }

  .divider-gold {
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, var(--gold-primary), var(--gold-light));
    margin: 18px 0;
  }

  /* Kakao Float */
  .kakao-float {
    position: fixed;
    bottom: 32px;
    right: 32px;
    z-index: 999;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 22px;
    background: #FEE500;
    color: #3A1D1D;
    font-family: "Noto Sans KR", sans-serif;
    font-weight: 700;
    font-size: 14px;
    border-radius: 50px;
    box-shadow: 0 4px 24px rgba(254, 229, 0, 0.45);
    transition: all var(--transition);
  }

  .kakao-float:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 36px rgba(254, 229, 0, 0.65);
  }

  .kakao-float:active { transform: translateY(0); }

  @media (max-width: 768px) {
    .kakao-float {
      bottom: 20px;
      right: 16px;
      padding: 12px 18px;
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
