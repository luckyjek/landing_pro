---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = "크라운코드 | 황제가 되는 본질",
  description = "세상은 동화가 아니니까 동화같은 세상을 만들어야지",
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="https://cdn.imweb.me/upload/S2026022631349774b0b42/069ca0194d408.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.crowncode.site/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content="https://www.crowncode.site" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.crowncode.site/og.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --white: #ffffff;
    --cream: #232323;
    --cream-deep: #2c2c2c;
    --gold-900: #c9a84c;
    --gold-700: #c9a84c;
    --gold-500: #b89040;
    --gold-400: #a07828;
    --gold-300: #7a5c20;
    --gold-100: #1e1600;
    --gold-border: rgba(255, 255, 255, 0.1);
    --gold-border-strong: rgba(255, 255, 255, 0.18);
    --gold-shadow: rgba(0, 0, 0, 0.5);
    --text-900: #f0f0f0;
    --text-700: #d0d0d0;
    --text-500: #999999;
    --text-300: #666666;
    --text-400: #808080;
    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-lg: 20px;
    --ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    height: auto;
  }

  body {
    overflow-x: hidden;
    scrollbar-gutter: stable;
  }

  body {
    background: #1a1a1a;
    color: var(--text-700);
    font-family: "Noto Sans KR", sans-serif;
    font-size: 16px;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4 {
    font-family: "Playfair Display", "Noto Sans KR", serif;
    color: var(--text-900);
    line-height: 1.2;
  }

  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; height: auto; display: block; }

  .gold-text {
    color: var(--text-900);
    -webkit-text-fill-color: var(--text-900);
    background: none;
  }

  .gold-line {
    display: block;
    width: 40px;
    height: 2px;
    background: var(--text-900);
    border-radius: 2px;
    margin: 16px 0 24px;
  }

  .label-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-500);
  }

  .btn-gold-outline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 13px 24px;
    background: transparent;
    color: var(--text-500);
    font-family: "Noto Sans KR", sans-serif;
    font-weight: 500;
    font-size: 14px;
    border-radius: var(--radius-md);
    border: 1.5px solid rgba(0,0,0,0.12);
    cursor: pointer;
    transition: all 0.22s var(--ease);
    text-decoration: none;
  }

  .btn-gold-outline:hover {
    background: var(--cream-deep);
    border-color: rgba(0,0,0,0.25);
    color: var(--text-700);
  }

  .btn-kakao {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 17px 24px;
    background: #FEE500;
    color: #391B1B;
    font-family: "Noto Sans KR", sans-serif;
    font-weight: 700;
    font-size: 16px;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    transition: all 0.22s var(--ease);
    box-shadow: 0 4px 20px rgba(254, 229, 0, 0.45);
    letter-spacing: 0.01em;
  }

  .btn-kakao:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(254, 229, 0, 0.6);
  }

  .btn-kakao:active { transform: translateY(0); }

  .btn-black {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 17px 24px;
    background: #ffffff;
    color: #111111;
    font-family: "Noto Sans KR", sans-serif;
    font-weight: 700;
    font-size: 16px;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    transition: all 0.22s var(--ease);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .btn-black:hover {
    background: #e8e8e8;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.55);
  }

  .btn-black:active { transform: translateY(0); }

  .btn-black:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
