    document.getElementById('book-email-error').textContent = '';
    var modal = document.getElementById('book-email-modal');
    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('is-open');
    setTimeout(function() { document.getElementById('book-email-input').focus(); }, 80);
  }

  function closeBookEmailModal() {
    var modal = document.getElementById('book-email-modal');
    modal.setAttribute('aria-hidden', 'true');
    modal.classList.remove('is-open');
  }

  async function proceedBookPayment() {
    var email = document.getElementById('book-email-input').value.trim();
    var errEl = document.getElementById('book-email-error');
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errEl.textContent = '올바른 이메일 주소를 입력해주세요.';
      return;
    }
    errEl.textContent = '';
    var btn = document.getElementById('book-email-confirm-btn');
    btn.disabled = true;
    btn.textContent = '결제창 여는 중...';
    var tp = window.TossPayments;
    if (!tp) {
      alert('결제 모듈이 로딩 중입니다. 잠시 후 다시 눌러주세요.');
      btn.disabled = false;
      btn.textContent = '결제하기';
      return;
    }
    closeBookEmailModal();
    try {
      var tossPayments = await tp(TOSS_CLIENT_KEY);
      var payment = tossPayments.payment({ customerKey: '@@ANONYMOUS' });
      var orderId = 'BOOK_' + Date.now() + '_' + Math.random().toString(36).slice(2, 9);
      await payment.requestPayment({
        method: 'CARD',
        amount: { currency: 'KRW', value: 5500 },
        orderId: orderId,
        orderName: '더 크라운코드',
        customerEmail: email,
        successUrl: window.location.origin + '/book/success?email=' + encodeURIComponent(email),
        failUrl: window.location.origin + '/book',
      });
    } catch (err) {
      console.error('[Toss] 결제 오류:', err);
      if (!err || err.code !== 'USER_CANCEL') {
        alert('결제 오류: ' + (err && err.message ? err.message : String(err)));
      }
    } finally {
      btn.disabled = false;
      btn.textContent = '결제하기';
    }
  }

  function switchTab(tab) {
    document.querySelectorAll('.tab-btn').forEach(function(btn) {
      btn.classList.toggle('tab-active', btn.dataset.tab === tab);
    });
    var target = document.getElementById('tab-' + tab);
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function initScrollSpy() {
    var sections = [
      document.getElementById('tab-book'),
      document.getElementById('tab-author'),
    ];
    var btns = document.querySelectorAll('.tab-btn');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var id = entry.target.id.replace('tab-', '');
          btns.forEach(function(btn) {
            btn.classList.toggle('tab-active', btn.dataset.tab === id);
          });
        }
      });
    }, { threshold: 0.3 });
    sections.forEach(function(sec) { if (sec) observer.observe(sec); });
  }


  function startViewerCounter() {
    var el = document.getElementById('viewer-count');
    if (!el) return;
    el.textContent = Math.floor(Math.random() * 46) + 5;
    setInterval(function() {
      el.textContent = Math.floor(Math.random() * 46) + 5;
    }, 60000);
  }

  function openPrivacyModal() {
    var modal = document.getElementById('privacy-modal');
    if (!modal) return;
    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('is-open');
  }

  function closePrivacyModal() {
    var modal = document.getElementById('privacy-modal');
    if (!modal) return;
    modal.setAttribute('aria-hidden', 'true');
    modal.classList.remove('is-open');
  }

  function handlePrivacyOverlayClick(e) {
    if (e.target.id === 'privacy-modal') closePrivacyModal();
  }

  document.addEventListener('DOMContentLoaded', function() {
    startViewerCounter();
    initScrollSpy();
    document.getElementById('book-email-modal').addEventListener('click', function(e) {
      if (e.target === this) closeBookEmailModal();
    });
    document.getElementById('book-email-input').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') proceedBookPayment();
    });
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { closePrivacyModal(); closeBookEmailModal(); }
  });
</script>

