];

const goals = [
  {
    num: "01",
    title: "이상형의 외국 모델과 교제하기",
    
    desc: "사실 외국 이성을 만나는 건 쉬워요. 진짜 어려운 건 이상형의 외국 모델과 교제하는 것입니다. 로이와 신사가 직접 실증한 방법을 담았습니다.",
