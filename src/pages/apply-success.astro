---
import LightLayout from '../layouts/LightLayout.astro';
const KAKAO_CHANNEL = "https://pf.kakao.com/_xoxxxxxx";
---

<LightLayout title="신청 완료 | 타이탄클래스 월말특강">
<div class="success-page">
  <div class="success-card">

    <div class="icon-wrap" aria-hidden="true">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <polyline points="9 12 11 14 15 10" stroke-width="2"/>
      </svg>
    </div>

    <span class="tag">신청 완료</span>
    <h1>신청이 <span class="gold-text">완료</span>되었습니다</h1>
    <p class="desc">
      카카오 계정으로 정보가 안전하게 접수되었습니다.<br />
      빠른 시일 내에 카카오톡 또는 문자로 안내드리겠습니다.
    </p>

    <div class="info-box">
      <div class="info-row">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span>2026년 5월 31일 (일) · 오전 10:00 — 오후 6:00</span>
      </div>
      <div class="info-row">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>서울 강남 (신청 확정 후 장소 안내)</span>
      </div>
    </div>

    <div class="cta-wrap">
      <a href={KAKAO_CHANNEL} target="_blank" rel="noopener noreferrer" class="btn-kakao">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 3C6.477 3 2 6.582 2 11c0 2.857 1.737 5.379 4.376 6.943L5.5 21l3.432-1.937A11.84 11.84 0 0 0 12 19.2c5.523 0 10-3.582 10-8.2S17.523 3 12 3z"/>
        </svg>
        카카오 채널에서 추가 안내 받기
      </a>
      <a href="/titan-class" class="btn-back">← 상세페이지로 돌아가기</a>
    </div>

  </div>
</div>
</LightLayout>

<style>
  .success-page {
    min-height: 100vh;
    background: #F0EDE6;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
  }

  .success-card {
    background: #fff;
    border: 1px solid rgba(184, 148, 30, 0.18);
    border-radius: 20px;
    padding: 64px 56px;
    max-width: 520px;
    width: 100%;
    text-align: center;
    box-shadow: 0 8px 48px rgba(0,0,0,0.06);
  }

  .icon-wrap {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, #8b6914, #c9a84c);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
  }

  .tag {
    display: inline-block;
    padding: 4px 14px;
    background: linear-gradient(135deg, #8b6914, #c9a84c);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border-radius: 50px;
    margin-bottom: 18px;
  }

  h1 {
    font-family: "Playfair Display", "Noto Sans KR", serif;
    font-size: 36px;
    font-weight: 900;
    line-height: 1.2;
    color: #111;
    margin-bottom: 14px;
  }

  .desc {
    font-size: 15px;
    color: #666;
    line-height: 1.85;
    margin-bottom: 32px;
  }

  .info-box {
    background: #fefcf6;
    border: 1px solid rgba(184, 148, 30, 0.18);
    border-radius: 12px;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 32px;
    text-align: left;
  }

  .info-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: #555;
    font-weight: 500;
  }

  .info-row svg { color: #c9a84c; flex-shrink: 0; }

  .cta-wrap {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .btn-back {
    font-size: 14px;
    color: #999;
    text-decoration: none;
    transition: color 0.2s;
  }

  .btn-back:hover { color: #555; }

  @media (max-width: 600px) {
    .success-card { padding: 48px 24px; }
    h1 { font-size: 28px; }
  }
</style>
