.transform-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text-300);
  margin-bottom: 16px;
}

.after-label { color: var(--gold-700); }

.transform-col ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.transform-before ul li {
  font-size: 14px;
  color: var(--text-500);
  padding-left: 14px;
  position: relative;
}

.transform-before ul li::before {
  content: "×";
  position: absolute;
  left: 0;
  color: #ccc;
  font-weight: 700;
}

.transform-after ul li {
  font-size: 14px;
  color: var(--text-700);
  font-weight: 500;
  padding-left: 16px;
  position: relative;
}

.transform-after ul li::before {
  content: "✓";
  position: absolute;
  left: 0;
  color: var(--gold-500);
  font-weight: 700;
}

.transform-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--gold-700), var(--gold-500));
  color: #fff;
  flex-shrink: 0;
}

/* ──────────────────────────────────────
   ④ CURRICULUM
────────────────────────────────────── */
.sec-curriculum { background: var(--cream); }

.topic-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.topic-card {
  background: #fff;
  border: 1px solid rgba(0,0,0,0.07);
  border-radius: var(--radius-lg);
  padding: 32px;
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
}

.topic-card:hover {
  border-color: var(--gold-border-strong);
  box-shadow: 0 4px 32px var(--gold-shadow);
  transform: translateY(-2px);
}

.topic-header {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-bottom: 14px;
}

.topic-num {
  font-family: "Playfair Display", serif;
  font-size: 28px;
  font-weight: 700;
  color: var(--gold-300);
  line-height: 1;
  flex-shrink: 0;
}

.topic-title {
  font-size: 20px;
  font-weight: 700;
  font-family: "Noto Sans KR", sans-serif;
  margin-bottom: 2px;
}

.topic-sub {
  font-size: 12px;
  color: var(--text-300);
  letter-spacing: 0.08em;
}

.topic-desc {
  font-size: 14px;
  color: var(--text-500);
  line-height: 1.85;
  margin-bottom: 18px;
  padding-bottom: 18px;
  border-bottom: 1px solid rgba(0,0,0,0.06);
}

.topic-points {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.topic-points li {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: var(--text-700);
  font-weight: 500;
}

.topic-points li svg {
  color: var(--gold-500);
  flex-shrink: 0;
}

/* ──────────────────────────────────────
   ⑤ INSTRUCTOR
────────────────────────────────────── */
.instructor-wrap {
  display: flex;
  gap: 36px;
  align-items: flex-start;
}

.instructor-photo {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  background: var(--cream-deep);
  border: 2px solid var(--gold-border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--gold-500);
}

.instructor-name {
  font-size: 26px;
  font-weight: 700;
  margin-bottom: 12px;
  font-family: "Noto Sans KR", sans-serif;
}

.instructor-badges {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.instructor-badges span {
  display: inline-block;
  padding: 4px 12px;
  background: var(--gold-100);
  border: 1px solid var(--gold-border);
  border-radius: 50px;
  font-size: 12px;
  color: var(--gold-700);
  font-weight: 600;
}

.instructor-bio {
  font-size: 15px;
  color: var(--text-500);
  line-height: 1.85;
  margin-bottom: 14px;
}

.instructor-bio strong { color: var(--text-900); }

.instructor-creds {
  display: flex;
  flex-direction: column;
  gap: 9px;
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid rgba(0,0,0,0.07);
}

.cred-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: var(--text-500);
}

.cred-icon {
  color: var(--gold-500);
  font-size: 8px;
  flex-shrink: 0;
}

/* ──────────────────────────────────────
   ⑥ SOCIAL PROOF
────────────────────────────────────── */
.sec-proof { background: var(--cream); }

.proof-numbers {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--gold-border);
  border: 1px solid var(--gold-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 40px;
}

.proof-num-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 32px 16px;
  background: #fff;
  text-align: center;
  transition: background 0.2s;
}

.proof-num-item:hover { background: var(--gold-100); }

.proof-big {
  font-family: "Playfair Display", serif;
  font-size: 40px;
  font-weight: 700;
  line-height: 1;
}

.proof-num-item span:last-child {
  font-size: 12px;
  color: var(--text-300);
  letter-spacing: 0.04em;
}

.testimonial-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.testimonial-card {
  background: #fff;
  border: 1px solid rgba(0,0,0,0.07);
  border-radius: var(--radius-lg);
  padding: 28px 32px;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.testimonial-card:hover {
  border-color: var(--gold-border);
  box-shadow: 0 4px 24px var(--gold-shadow);
}

.testimonial-top {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  margin-bottom: 18px;
}

.testimonial-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--gold-700), var(--gold-400));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 700;
  font-size: 17px;
  flex-shrink: 0;
}

.testimonial-name {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: var(--text-900);
  margin-bottom: 6px;
}

.testimonial-change {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
}

.change-before {
  color: var(--text-300);
  text-decoration: line-through;
}

.change-before, .change-after { max-width: 180px; }

.change-after {
  color: var(--gold-700);
  font-weight: 600;
}

.testimonial-change svg { color: var(--gold-400); flex-shrink: 0; }

.testimonial-quote {
  font-size: 14px;
  color: var(--text-500);
  line-height: 1.85;
  font-style: normal;
  margin-bottom: 14px;
}

.testimonial-stars {
  color: var(--gold-400);
  font-size: 14px;
  letter-spacing: 2px;
}

/* ──────────────────────────────────────
   ⑦ INCLUDES
────────────────────────────────────── */
.includes-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.include-card {
  background: var(--cream);
  border: 1px solid var(--gold-border);
  border-radius: var(--radius-md);
  padding: 24px 22px;
  transition: background 0.2s, box-shadow 0.2s, transform 0.2s;
}

.include-card:hover {
  background: var(--gold-100);
  box-shadow: 0 2px 20px var(--gold-shadow);
  transform: translateY(-2px);
}

.include-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-sm);
  background: #fff;
  border: 1px solid var(--gold-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gold-700);
  margin-bottom: 14px;
}

.include-card h4 {
  font-size: 15px;
  font-weight: 700;
  font-family: "Noto Sans KR", sans-serif;
  margin-bottom: 8px;
}

.include-card p {
  font-size: 13px;
  color: var(--text-500);
  line-height: 1.75;
}

/* ──────────────────────────────────────
   ⑧ FAQ
────────────────────────────────────── */
.sec-faq { background: var(--cream); }

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.faq-item {
  background: #fff;
  border: 1px solid rgba(0,0,0,0.07);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: border-color 0.2s;
}

.faq-item[open], .faq-item:hover {
  border-color: var(--gold-border-strong);
}

.faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px 24px;
  cursor: pointer;
  list-style: none;
  font-size: 15px;
  font-weight: 600;
  color: var(--text-900);
}

.faq-q::-webkit-details-marker { display: none; }

.faq-arrow {
  flex-shrink: 0;
  color: var(--text-300);
  transition: transform 0.2s;
}

.faq-item[open] .faq-arrow { transform: rotate(180deg); }

.faq-a {
  padding: 0 24px 20px;
  font-size: 14px;
  color: var(--text-500);
  line-height: 1.85;
  border-top: 1px solid rgba(0,0,0,0.06);
  padding-top: 16px;
  margin: 0 24px;
}

/* ──────────────────────────────────────
   ⑨ FINAL CTA
────────────────────────────────────── */
.sec-final {
  background: var(--text-900);
  border-bottom: none;
  padding: 96px 64px;
}

.final-inner { max-width: 580px; }

.final-title {
  font-size: clamp(32px, 4vw, 48px);
  font-weight: 900;
  color: #fff;
  line-height: 1.15;
  margin-bottom: 20px;
  letter-spacing: -0.01em;
}

.final-title em {
  font-style: italic;
  color: var(--text-500);
}

.final-desc {
  font-size: 16px;
  color: rgba(255,255,255,0.55);
  line-height: 1.8;
  margin-bottom: 40px;
}

.final-desc strong { color: rgba(255,255,255,0.85); }

.final-ctas {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 380px;
  margin-bottom: 24px;
}

.final-btn {
  font-size: 17px;
  padding: 18px 24px;
}

.btn-ghost-white {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 15px 24px;
  background: transparent;
  color: rgba(255,255,255,0.6);
  font-family: "Noto Sans KR", sans-serif;
  font-weight: 500;
  font-size: 14px;
  border-radius: var(--radius-md);
  border: 1px solid rgba(255,255,255,0.15);
  cursor: pointer;
  transition: all 0.22s;
  text-decoration: none;
}

.btn-ghost-white:hover {
  background: rgba(255,255,255,0.06);
  border-color: rgba(255,255,255,0.3);
  color: #fff;
}

.final-seats {
  font-size: 13px;
  color: rgba(255,255,255,0.45);
}

.final-seats strong { color: rgba(255,255,255,0.7); }

/* ──────────────────────────────────────
   RIGHT PANEL
────────────────────────────────────── */
.panel-tag {
  font-size: 12px;
  font-weight: 700;
  color: var(--text-500);
  letter-spacing: 0.08em;
  margin-bottom: 12px;
}

.panel-main-title {
  font-size: 20px;
  font-weight: 900;
  line-height: 1.35;
  color: var(--text-900);
  font-family: "Noto Sans KR", sans-serif;
  word-break: keep-all;
  margin-bottom: 16px;
}

.panel-meta-row {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  color: var(--text-500);
  font-weight: 500;
  margin-bottom: 20px;
}

.panel-meta-row svg {
  flex-shrink: 0;
  color: var(--text-400);
}

.panel-cta-btn {
  font-size: 16px;
  padding: 12px 12px;
  border-radius: var(--radius-sm);
  margin-bottom: 12px;
}

.panel-viewers {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  font-size: 12px;
  color: var(--text-500);
  margin-bottom: 10px;
}

.panel-viewers strong {
  color: var(--text-900);
  font-weight: 700;
}

.panel-viewers-dot {
  position: relative;
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
  flex-shrink: 0;
  animation: dot-glow 2.8s ease-in-out infinite;
}

.panel-viewers-dot::after {
  content: '';
  position: absolute;
  inset: -3px;
  border-radius: 50%;
  background: #22c55e;
  opacity: 0;
  animation: dot-ripple 2.8s ease-in-out infinite;
}

@keyframes dot-glow {
  0%, 100% { opacity: 0.55; box-shadow: 0 0 0px #22c55e; }
  50%       { opacity: 1;    box-shadow: 0 0 6px rgba(34,197,94,0.6); }
}

@keyframes dot-ripple {
  0%   { transform: scale(1);   opacity: 0.35; }
  70%  { transform: scale(2.6); opacity: 0; }
  100% { transform: scale(2.6); opacity: 0; }
}

.panel-inquiry-link {
  display: block;
  text-align: center;
  font-size: 13px;
  color: var(--text-300);
  text-decoration: none;
  padding: 8px 0;
  transition: color 0.18s;
}

.panel-inquiry-link:hover {
  color: var(--text-700);
  text-decoration: underline;
}

/* ──────────────────────────────────────
   MOBILE BOTTOM BAR
────────────────────────────────────── */
.mobile-bar {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.97);
  border-top: 1px solid var(--gold-border);
  backdrop-filter: blur(12px);
  align-items: center;
  gap: 16px;
}

.mobile-bar-label {
  font-size: 12px;
  color: var(--text-500);
  flex-shrink: 0;
  white-space: nowrap;
}

.mobile-kakao-btn {
  flex: 1;
  font-size: 15px;
  padding: 14px 16px;
  border-radius: var(--radius-sm);
}

/* ──────────────────────────────────────
   RESPONSIVE
────────────────────────────────────── */
@media (max-width: 1100px) {
  .page-wrapper { grid-template-columns: 1fr 300px; }
  .sec { padding: 64px 40px; }
  .sec-final { padding: 72px 40px; }
  .panel-scroll { padding: 24px 20px 16px; }
}

@media (max-width: 768px) {
  .page-wrapper {
    grid-template-columns: 1fr;
  }
  .content-left {
    border-right: none;
    padding-bottom: 90px;
  }
  .panel-right { display: none; }
  .mobile-bar { display: flex; }
  .sec { padding: 52px 22px; }
  .sec-final { padding: 60px 22px; }
  .transform-grid { grid-template-columns: 1fr; gap: 16px; }
  .transform-arrow { transform: rotate(90deg); margin: 0 auto; }
  .includes-grid { grid-template-columns: 1fr; }
  .instructor-wrap { flex-direction: column; gap: 20px; }
  .proof-numbers { grid-template-columns: 1fr; gap: 0; }
}

@media (max-width: 480px) {
  .hero-title { font-size: 32px; }
  .hero-numbers { flex-direction: column; }
  .hero-num-divider { width: 60px; height: 1px; }
  .testimonial-change { flex-wrap: wrap; }
}

/* ──────────────────────────────────────
   APPLY MODAL
────────────────────────────────────── */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 9000;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s var(--ease);
}

.modal-overlay.is-open {
  opacity: 1;
  pointer-events: auto;
}

.modal-card {
  position: relative;
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 44px 40px 40px;
  width: 100%;
  max-width: 460px;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.25);
  transform: translateY(16px) scale(0.98);
  transition: transform 0.28s var(--ease);
}

.modal-overlay.is-open .modal-card {
  transform: translateY(0) scale(1);
}

.modal-close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.1);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--text-500);
  transition: all 0.18s;
}

.modal-close:hover {
  background: rgba(0, 0, 0, 0.06);
  color: var(--text-900);
}

.modal-badge {
  display: inline-block;
  padding: 4px 12px;
  background: #111111;
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  border-radius: 50px;
  margin-bottom: 14px;
}

.modal-title {
  font-size: 26px;
  font-weight: 700;
  color: var(--text-900);
  margin-bottom: 8px;
  line-height: 1.2;
}

.modal-desc {
  font-size: 14px;
  color: var(--text-500);
  line-height: 1.65;
  margin-bottom: 28px;
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.form-group label {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-700);
  letter-spacing: 0.02em;
}

.required {
  color: #e53e3e;
  margin-left: 2px;
}

.form-group input {
  width: 100%;
  padding: 13px 16px;
  font-family: "Noto Sans KR", sans-serif;
  font-size: 15px;
  color: var(--text-900);
  background: #fafafa;
  border: 1.5px solid rgba(0, 0, 0, 0.12);
  border-radius: var(--radius-md);
  outline: none;
  transition: border-color 0.18s, box-shadow 0.18s;
  -webkit-appearance: none;
}

.form-group input::placeholder {
  color: var(--text-300);
}

.form-group input:focus {
  border-color: #111111;
  box-shadow: 0 0 0 3px rgba(17, 17, 17, 0.08);
  background: #ffffff;
}

.form-error {
  font-size: 13px;
  color: #e53e3e;
  min-height: 18px;
  margin-top: -6px;
}

.modal-submit-btn {
  margin-top: 4px;
  font-size: 17px;
  padding: 17px 24px;
}

@media (max-width: 480px) {
  .modal-card {
    padding: 36px 24px 28px;
  }
  .modal-title { font-size: 22px; }
}

/* ──────────────────────────────────────
   개인정보 동의
────────────────────────────────────── */
.privacy-agree-wrap {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 14px 16px;
  background: #fafafa;
  border: 1.5px solid rgba(0,0,0,0.1);
  border-radius: var(--radius-md);
}

.privacy-check-label {
  display: flex;
  align-items: center;
  gap: 9px;
  cursor: pointer;
  flex-wrap: wrap;
}

.privacy-checkbox {
  display: none;
}

.privacy-check-custom {
  width: 18px;
  height: 18px;
  border-radius: 4px;
  border: 1.5px solid rgba(0,0,0,0.2);
  background: #fff;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s, border-color 0.15s;
}

.privacy-checkbox:checked + .privacy-check-custom {
  background: #111111;
  border-color: #111111;
}

.privacy-checkbox:checked + .privacy-check-custom::after {
  content: '';
  display: block;
  width: 5px;
  height: 9px;
  border: 2px solid #fff;
  border-top: none;
  border-left: none;
  transform: rotate(45deg) translate(-1px, -1px);
}

.privacy-check-txt {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-700);
  flex: 1;
}

.privacy-toggle-btn {
  font-size: 12px;
  color: var(--text-300);
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  text-decoration: underline;
  font-family: "Noto Sans KR", sans-serif;
  transition: color 0.15s;
  flex-shrink: 0;
}

.privacy-toggle-btn:hover { color: var(--text-700); }

.privacy-detail {
  border-top: 1px solid rgba(0,0,0,0.07);
  padding-top: 10px;
}

.privacy-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 11px;
  color: var(--text-500);
  margin-bottom: 10px;
}

.privacy-table th,
.privacy-table td {
  padding: 7px 8px;
  border: 1px solid rgba(0,0,0,0.08);
  text-align: center;
  line-height: 1.5;
}

.privacy-table th {
  background: #f0f0f0;
  font-weight: 700;
  color: var(--text-700);
}

.privacy-notice {
  font-size: 11px;
  color: var(--text-300);
  line-height: 1.7;
