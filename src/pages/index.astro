  <!-- ═══════════════════════════════════════════════
       RIGHT: STICKY ENROLLMENT PANEL
  ═══════════════════════════════════════════════ -->
  <aside class="panel-right" aria-label="수강 신청 패널">
    <div class="panel-scroll">

