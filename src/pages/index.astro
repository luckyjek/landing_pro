</div>

<!-- Mobile bottom bar -->
<div class="mobile-bar" aria-label="모바일 신청">
  <span class="mobile-bar-label" id="mobile-date-text">—</span>
  <button class="btn-black mobile-kakao-btn" onclick="openApplyModal()">
    무료강의 신청하기
