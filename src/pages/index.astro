          <li>이메일 : a39274302@gmail.com</li>
          <li>주소 : 경기도 의정부시 녹양로66</li>
        </ul>
      </div>

      <p class="privacy-effective-date">시행일 : 2026년 06월 05일</p>

    </div>

    <button class="btn-black privacy-confirm-btn" onclick="closePrivacyModal()">확인</button>
  </div>
</div>

</LightLayout>

<script is:inline>
  function switchTab(tab) {
    var target = document.getElementById('tab-' + tab);
    if (!target) return;
    document.querySelectorAll('.tab-btn').forEach(function(btn) {
      btn.classList.toggle('tab-active', btn.dataset.tab === tab);
    });
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function initScrollSpy() {
    var sections = [
      document.getElementById('tab-class'),
      document.getElementById('tab-instructor'),
    ];
    var btns = document.querySelectorAll('.tab-btn');

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var id = entry.target.id.replace('tab-', '');
          btns.forEach(function(btn) {
            btn.classList.toggle('tab-active', btn.dataset.tab === id);
          });
        }
      });
    }, { threshold: 0.3 });

    sections.forEach(function(sec) { if (sec) observer.observe(sec); });
  }

  function openApplyModal() {
    const modal = document.getElementById('apply-modal');
    if (!modal) return;
    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('is-open');
    setTimeout(() => {
      const nameInput = document.getElementById('input-name');
      if (nameInput) nameInput.focus();
    }, 80);
  }

  function closeApplyModal() {
    const modal = document.getElementById('apply-modal');
    if (!modal) return;
    modal.setAttribute('aria-hidden', 'true');
    modal.classList.remove('is-open');
    // 성공 화면이 표시된 경우 원래 폼으로 복원
    const card = modal.querySelector('.modal-card');
    if (card && card.classList.contains('success-mode')) {
      card.classList.remove('success-mode');
      card.innerHTML = originalCardHTML;
    }
  }

  function handleOverlayClick(e) {
    if (e.target.id === 'apply-modal') closeApplyModal();
  }

  // 원본 카드 HTML 보존 + 전화번호 포맷터 연결
  var originalCardHTML = '';
  function syncFixedPanel() {
    var placeholder = document.querySelector('.panel-right');
    var panel = document.querySelector('.panel-scroll');
    if (!placeholder || !panel) return;
    var rect = placeholder.getBoundingClientRect();
    panel.style.left  = rect.left + 'px';
    panel.style.width = rect.width + 'px';
  }

  document.addEventListener('DOMContentLoaded', function() {
    const card = document.querySelector('.modal-card');
    if (card) originalCardHTML = card.innerHTML;
    attachPhoneFormatter();
    updateEventDate();
    startViewerCounter();
    syncFixedPanel();
    initScrollSpy();
  });

  window.addEventListener('resize', syncFixedPanel);

  function startViewerCounter() {
    var el = document.querySelector('.panel-viewers strong');
    if (!el) return;
    setInterval(function() {
      var next = Math.floor(Math.random() * 46) + 5; // 5~50
      el.textContent = next + '명';
    }, 60000);
  }

  function updateEventDate() {
    var DAY_KO = ['일', '월', '화', '수', '목', '금', '토'];

    function lastDayOf(year, month) {
      return new Date(year, month + 1, 0);
    }

    function getEventDate() {
      var now = new Date();
      var last = lastDayOf(now.getFullYear(), now.getMonth());
      var event = new Date(last.getFullYear(), last.getMonth(), last.getDate(), 19, 0, 0);
      if (now >= event) {
        var nm = now.getMonth() === 11 ? 0 : now.getMonth() + 1;
        var ny = now.getMonth() === 11 ? now.getFullYear() + 1 : now.getFullYear();
        last = lastDayOf(ny, nm);
        event = new Date(last.getFullYear(), last.getMonth(), last.getDate(), 19, 0, 0);
      }
      return event;
    }

    var event = getEventDate();
    var month = event.getMonth() + 1;
    var date  = event.getDate();
    var day   = DAY_KO[event.getDay()];

    var txt = month + '월 ' + date + '일 (' + day + ') 오후 7시';
    var dateEl = document.getElementById('panel-date-text');
    if (dateEl) dateEl.textContent = txt;
    var mobileEl = document.getElementById('mobile-date-text');
    if (mobileEl) mobileEl.textContent = txt;
  }

  function attachPhoneFormatter() {
    const phoneEl = document.getElementById('input-phone');
    if (!phoneEl) return;
    phoneEl.addEventListener('input', function() {
      var formatted = formatPhone(this.value);
      this.value = formatted;
    });
  }

  function formatPhone(value) {
    var digits = value.replace(/\D/g, '').slice(0, 11);
    if (digits.length <= 3) return digits;
    if (digits.startsWith('02')) {
      if (digits.length <= 6)  return digits.slice(0,2) + '-' + digits.slice(2);
      if (digits.length <= 9)  return digits.slice(0,2) + '-' + digits.slice(2,5) + '-' + digits.slice(5);
      return digits.slice(0,2) + '-' + digits.slice(2,6) + '-' + digits.slice(6);
    }
    if (digits.length <= 6)  return digits.slice(0,3) + '-' + digits.slice(3);
    if (digits.length <= 10) return digits.slice(0,3) + '-' + digits.slice(3,6) + '-' + digits.slice(6);
    return digits.slice(0,3) + '-' + digits.slice(3,7) + '-' + digits.slice(7);
  }

  function isValidPhone(phone) {
    return /^(01[0-9]-\d{3,4}-\d{4}|02-\d{3,4}-\d{4}|0[3-9]\d-\d{3,4}-\d{4})$/.test(phone);
  }

  function confirmSuccess() {
    closeApplyModal();
    window.open('https://pf.kakao.com/_BEKsX', '_blank');
  }

  function showSuccess(name) {
    const card = document.querySelector('.modal-card');
    if (!card) return;
    card.classList.add('success-mode');
    card.innerHTML = `
      <div class="success-inner">
        <h2 class="success-emoji-wrap">🎉</h2>
        <h2 class="success-title">월말특강 수강신청완료!</h2><br>
        <p class="success-body" style="margin-top:20px;">
        <strong>${name}님,
          카톡채널 추가하시면<br>커뮤니티 입장링크<br>전송해드립니다.</strong>
        </p>
        <button class="btn-black success-close-btn" onclick="confirmSuccess()" style="font-size:15px;padding:14px 24px;margin-top:20px;">확인</button>
      </div>
    `;
    launchConfetti();
  }

  function launchConfetti() {
    const overlay = document.getElementById('apply-modal');
    const colors = ['#C9A84C','#F0D080','#111111','#8B6914','#E8CC7A','#FF6B6B','#4ECDC4','#ffffff','#FFD93D'];
    const total = 90;

    for (var i = 0; i < total; i++) {
      (function(idx) {
        var piece = document.createElement('div');
        var isLeft = idx < total / 2;
        var startPct = isLeft ? Math.random() * 18 : 82 + Math.random() * 18;
        var color = colors[Math.floor(Math.random() * colors.length)];
        var w = 5 + Math.random() * 7;
        var h = 9 + Math.random() * 10;
        var delay = Math.random() * 350;

        piece.style.cssText = [
          'position:fixed',
          'bottom:0',
          'left:' + startPct + '%',
          'width:' + w + 'px',
          'height:' + h + 'px',
          'background:' + color,
          'border-radius:2px',
          'z-index:9999',
          'pointer-events:none',
          'opacity:1',
        ].join(';');

        overlay.appendChild(piece);

        // 왼쪽은 오른쪽 위 방향, 오른쪽은 왼쪽 위 방향으로 발사
        var spreadAngle = isLeft
          ? (50 + Math.random() * 70)   // 50°~120° (왼쪽에서 오른쪽 위)
          : (60 + Math.random() * 70);  // 60°~130° (오른쪽에서 왼쪽 위)
        var rad = spreadAngle * Math.PI / 180;
        var speed = 300 + Math.random() * 350;
        var vx = (isLeft ? 1 : -1) * Math.cos(rad) * speed;
        var vy = -Math.sin(rad) * speed;
        var rotate = 360 + Math.random() * 720;

        setTimeout(function() {
          piece.animate([
            { transform: 'translate(0,0) rotate(0deg)', opacity: 1 },
            { transform: 'translate(' + vx * 0.6 + 'px,' + vy * 0.6 + 'px) rotate(' + (rotate * 0.5) + 'deg)', opacity: 1, offset: 0.45 },
            { transform: 'translate(' + (vx + Math.random() * 60 - 30) + 'px,' + (vy + 700) + 'px) rotate(' + rotate + 'deg)', opacity: 0 }
          ], {
            duration: 1400 + Math.random() * 600,
            easing: 'ease-in',
            fill: 'forwards'
          }).onfinish = function() { piece.remove(); };
        }, delay);
      })(i);
    }
  }

  async function submitApplyForm(e) {
    e.preventDefault();
    const form = e.target;
    const nameEl  = form.querySelector('#input-name');
    const phoneEl = form.querySelector('#input-phone');
    const errEl   = document.getElementById('form-error');
    const btn     = document.getElementById('modal-submit-btn');

    const privacyCheck = form.querySelector('#privacy-check');
    if (!nameEl?.value.trim() || !phoneEl?.value.trim()) {
      if (errEl) errEl.textContent = '모든 항목을 입력해주세요.';
      return;
    }
    if (!privacyCheck?.checked) {
      if (errEl) errEl.textContent = '개인정보 수집 및 이용에 동의해주세요.';
      return;
    }

    if (!isValidPhone(phoneEl.value.trim())) {
      if (errEl) errEl.textContent = '올바른 전화번호를 입력해주세요. (예: 010-1234-5678)';
      phoneEl.focus();
      return;
    }

    var enteredName = nameEl.value.trim();
    btn.disabled = true;
    btn.textContent = '저장 중...';
    if (errEl) errEl.textContent = '';

    try {
      const res = await fetch('/api/apply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: enteredName,
          phone: phoneEl.value.trim(),
        }),
      });

      if (res.ok) {
        showSuccess(enteredName);
      } else {
        throw new Error();
      }
    } catch {
      if (errEl) errEl.textContent = '오류가 발생했습니다. 잠시 후 다시 시도해주세요.';
      btn.disabled = false;
      btn.textContent = '무료 입장하기';
    }
  }

  function openPrivacyModal() {
    var modal = document.getElementById('privacy-modal');
    if (!modal) return;
    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('is-open');
  }

  function closePrivacyModal() {
    var modal = document.getElementById('privacy-modal');
    if (!modal) return;
    modal.setAttribute('aria-hidden', 'true');
    modal.classList.remove('is-open');
  }

  function handlePrivacyOverlayClick(e) {
    if (e.target.id === 'privacy-modal') closePrivacyModal();
  }

  function togglePrivacy(e) {
    e.preventDefault();
    var detail = document.getElementById('privacy-detail');
    var btn = e.currentTarget;
    if (!detail) return;
    var isHidden = detail.hidden;
    detail.hidden = !isHidden;
    btn.textContent = isHidden ? '접기' : '내용보기';
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeApplyModal();
  });
</script>

