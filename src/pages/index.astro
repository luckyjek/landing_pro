<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="site-header-logo">
      <img
        src="https://cdn.imweb.me/upload/S2026022631349774b0b42/069ca0194d408.png"
        alt="크라운코드 로고"
        class="header-logo-img"
      />
      <span class="header-brand-name">크라운코드</span>
    </a>
  </div>
</header>

<div class="page-wrapper">

  <!-- LEFT: 이미지 + 탭 -->
  <main class="content-left">

    <!-- 썸네일: 항상 표시 -->
    <img
      src="https://cdn.imweb.me/upload/S2026022631349774b0b42/d69bc79ac0342.png"
      alt="썸네일"
      class="detail-img"
    />

    <!-- 탭 네비게이션 -->
    <div class="tab-nav">
      <button class="tab-btn tab-active" data-tab="class" onclick="switchTab('class')">클래스 소개</button>
