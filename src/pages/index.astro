    <button class="modal-close" onclick="closeApplyModal()" aria-label="닫기">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <div class="modal-header">
      <span class="modal-badge">크라운코드 커뮤니티</span>
      <h2 id="modal-title" class="modal-title">무료 입장 신청</h2>
      <p class="modal-desc">아래 정보를 입력하시면 커뮤니티에 무료로 입장하실 수 있습니다.</p>
    </div>

    <form id="apply-form" class="modal-form" onsubmit="submitApplyForm(event)" novalidate>
      <div class="form-group">
        <label for="input-name">이름 <span class="required">*</span></label>
        <input type="text" id="input-name" name="name" placeholder="실명을 입력해주세요" autocomplete="name" required />
      </div>
      <div class="form-group">
        <label for="input-phone">전화번호 <span class="required">*</span></label>
        <input type="tel" id="input-phone" name="phone" placeholder="010-0000-0000" autocomplete="tel" required />
      </div>
      <!-- 개인정보 동의 -->
