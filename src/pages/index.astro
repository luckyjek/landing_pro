        <label class="privacy-check-label">
          <input type="checkbox" id="privacy-check" class="privacy-checkbox" />
          <span class="privacy-check-custom"></span>
          <span class="privacy-check-txt">개인정보 수집 및 이용에 동의합니다. <span class="required">*</span></span>
          <button type="button" class="privacy-toggle-btn" onclick="togglePrivacy(event)">내용보기</button>
        </label>
        <div id="privacy-detail" class="privacy-detail" hidden>
          <table class="privacy-table">
