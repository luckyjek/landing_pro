      src="https://cdn.imweb.me/upload/S2026022631349774b0b42/a4614efc54172.png"
      alt="무료강의 신청하기"
      class="detail-img detail-img-cta"
      onclick="openApplyModal()"
    />

    <!-- 강사 소개 섹션: 3번째 이미지 아래 -->
